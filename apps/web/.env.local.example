# Yggdrasight — local development environment template
# Copy to apps/web/.env.local and fill in your values:
#   cp apps/web/.env.local.example apps/web/.env.local

# ── Required ──────────────────────────────────────────────────────────────────
# Local MongoDB + Redis (docker compose up -d mongodb redis)
MONGODB_URI=mongodb://yggdrasight:yggdrasight_dev_secret@localhost:27017/yggdrasight?authSource=admin
REDIS_URL=redis://localhost:6379

# TypeSafe intelligence — classification + analysis judgment engine.
# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# TypeSafe overrides (defaults shown)
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# Auth: development runs without the password-hash gate by default.
# Force it on/off in any environment:
# AUTH_DISABLED=1   # always skip auth (local single-user)
# AUTH_DISABLED=0   # always require auth (even in dev)

# Market data providers (public endpoints work without keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_API_KEY=

# AI providers — used by OpenCode for the research/discovery/chat agents
# (local runs fall back to the host's ~/.local/share/opencode/auth.json)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# Webhook ingestion security
WEBHOOK_SECRET=
